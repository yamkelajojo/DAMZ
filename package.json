{
  "name": "damz",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:customer": "bun --filter=@damz/customer run start",
    "dev:runner": "bun --filter=@damz/runner run start",
    "dev:converter": "bun --filter=@damz/converter run start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.25.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2"
  },
  "packageManager": "bun@1.1.0",
  "engines": {
    "node": ">=20.19 <23"
  }
}