{
  "name": "damz",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:customer": "bun --filter=@damz/customer run start",
    "dev:runner": "bun --filter=@damz/runner run start",
    "dev:converter": "bun --filter=@damz/converter run start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "db:generate": "turbo run db:generate",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "@types/react": "^18.3.0",
    "@types/react-native": "^0.76.0"
  },
  "packageManager": "bun@1.1.0",
  "engines": {
    "node": ">=20.19 <23"
  }
}